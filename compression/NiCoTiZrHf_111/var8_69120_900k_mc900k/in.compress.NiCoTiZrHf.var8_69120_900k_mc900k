# Initialize simulation
atom_style	atomic
units		metal
read_data	compression/NiCoTiZrHf_111/structure/NiCoTiZrHf_69120_mc_900.lmp

mass		1 58.6934
mass        2 58.933195
mass        3 47.867
mass        4 91.224

pair_style	snap
pair_coeff	* * ../../../potentials/HEA_var8.snapcoeff ../../../potentials/HEA_var8.snapparam Ni Co Ti Zr

###################################################
variable	target_T equal 900
neighbor        1.0 bin
neigh_modify    every 5 delay 0 check yes

variable	lenx equal lx
variable	leny equal ly
variable	lenz equal lz
variable	strxx equal pxx
variable	stryy equal pyy
variable	strzz equal pzz

# Set up and run MD in NPT ensemble
timestep	0.001
neighbor	1.0 bin
neigh_modify	every 5 delay 0 check yes 
thermo_style	custom step temp pe pxx pyy pzz lx ly lz 
thermo		1000 

reset_timestep	0
velocity	all create ${target_T} 12345678 dist gaussian rot yes mom yes
dump		1 all custom 1000 md_npt_dump.cfg id type x y z 
fix		1 all npt temp 900 900 0.1 aniso 0 0 1.0
fix		avg all ave/time 10 500 50000 v_lenx v_leny v_lenz
run		50000
undump		1
unfix		1
variable	newlx equal f_avg[1]
variable	newly equal f_avg[2]
variable	newlz equal f_avg[3]
change_box	all x final 0 ${newlx} y final 0 ${newly} z final 0 ${newlz} remap units box
unfix		avg
write_data	after_relax.data nocoeff

###########################################
variable	init_lx equal $(lx)
variable	del_x equal ${init_lx}*(-0.001)
variable	comp_loop loop 21
reset_timestep	0
print		"strain  stressx  stressy  stressz  " file SS_curve_var8_69120_900k_mc900k.txt
dump		1 all custom 1000 compress_dump_var8_69120_900k_mc900k.cfg id type x y z
label		compress
if		"${comp_loop} > 1" then &
		"change_box	all x delta 0 ${del_x} remap units box"
variable        strain equal 1-$(lx)/${init_lx}
thermo_style	custom step temp pe pxx pyy pzz lx ly lz v_strain 
fix		1 all npt temp ${target_T} ${target_T} 0.1 y 0.0 0.0 1.0 z 0.0 0.0 1.0
fix		2 all ave/time 10 100 10000 v_strxx v_stryy v_strzz 
run 		10000
unfix		1
variable	ave_stressx equal f_2[1]*1E-4
variable	ave_stressy equal f_2[2]*1E-4
variable	ave_stressz equal f_2[3]*1E-4
print		"${strain} ${ave_stressx} ${ave_stressy} ${ave_stressz} " append SS_curve_var8_69120_900k_mc900k.txt
unfix		2
write_data 	after_md_${comp_loop}.data nocoeff
next		comp_loop
jump		in.compress.NiCoTiZrHf.var8_69120_900k_mc900k compress
undump		1
