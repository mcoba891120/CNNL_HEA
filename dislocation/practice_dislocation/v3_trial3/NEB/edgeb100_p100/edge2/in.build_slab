atom_style      atomic
units           metal
boundary        p p p
read_data       HEA_init_edge2.data

mass     	1 58.6934
mass     	2 58.933195
mass     	3 47.867
mass     	4 91.224
mass        5 178.49
###############################

variable lx equal $(lx)
variable ly equal $(ly)
variable lz equal $(lz)

change_box 	all x final 0 ${lx} y final 0 ${ly} z final 0 ${lz} remap units box
change_box	all z delta -25 25 units box
change_box	all z final 0 $(lz) remap units box

write_data 	tmp_slab2.data nocoeff
