atom_style	atomic
units		metal
read_data	../../../../standard_model/random_x111_y112_z110/sample1/MD_300K/after_relax_bulk.data

pair_style	zero 1.0
pair_coeff 	* *
dump		1 all custom 1 temp.cfg id type x y z
run		0
undump		1
clear

