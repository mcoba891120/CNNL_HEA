atom_style      atomic
units           metal
boundary        p p p
read_data       ../HEA_init.data

mass     	1 58.6934
mass     	2 58.933195
mass     	3 47.867
mass     	4 91.224
mass     	5 178.49
###############################
pair_style      snap 
pair_coeff      * * ../../../../../../../../../potentials/HEA_v3_trial3.snapcoeff ../../../../../../../../../potentials/HEA_v3_trial3.snapparam Ni Co Ti Zr Hf

variable 	sys_T equal 600
# Setup output
thermo_style 	custom step temp pe pxx pyy pzz lx ly lz density
thermo		100

# Set up NVE run
timestep 	0.001
neighbor 	1.0 bin
neigh_modify 	every 5 delay 0 check yes 

variable 	lenx equal lx
variable 	leny equal ly
variable 	lenz equal lz

# Run MD
reset_timestep	0
velocity 	all create ${sys_T} 36954846 dist gaussian mom yes rot yes
fix 		f all momentum 100 linear 1 1 1 angular
dump 		1 all custom 1000 md_npt_dump.cfg id type x y z
fix 		1 all npt temp ${sys_T} ${sys_T} 0.1 aniso 0 0 1.0
fix 		avg all ave/time 10 5000 200000 v_lenx v_leny v_lenz
run		200000
undump		1
unfix		1

variable	newxhi equal f_avg[1]
variable	newyhi equal f_avg[2]
variable	newzhi equal f_avg[3]
change_box	all x final 0 ${newxhi} y final 0 ${newyhi} z final 0 ${newzhi} remap units box
unfix		avg
minimize	0 0.02 5000 10000
write_data	after_relax_bulk.data nocoeff

