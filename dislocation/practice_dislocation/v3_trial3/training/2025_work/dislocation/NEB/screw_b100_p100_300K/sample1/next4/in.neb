# Demonstrate SNAP Ta potential

# Initialize simulation
atom_style atomic
units metal
atom_modify map yes
read_data HEA_opt_edge1.data

mass     1 58.6934
mass     2 58.933195
mass     3 47.867
mass     4 91.224
mass     5 178.49

pair_style      snap
pair_coeff      * * ../../../../../../../../../../potentials/HEA_v3_trial3.snapcoeff ../../../../../../../../../../potentials/HEA_v3_trial3.snapparam Ni Co Ti Zr Hf

neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 100000 

thermo_style custom step pe pxx pyy pzz 
thermo		10

reset_timestep  0

variable	upp_zhi equal bound(all,zmax)
variable	upp_zlo equal ${upp_zhi}-4.0
variable	bot_zlo equal bound(all,zmin)
variable	bot_zhi equal ${bot_zlo}+4.0
region		fix_upp block EDGE EDGE EDGE EDGE ${upp_zlo} ${upp_zhi} units box
region		fix_bot block EDGE EDGE EDGE EDGE ${bot_zlo} ${bot_zhi} units box
region		constrain union 2 fix_upp fix_bot
group		constrain region constrain
fix		f constrain setforce NULL NULL 0

variable        u uloop 9

min_style	quickmin
dump 1 all atom 100 dump.neb.$u
timestep 0.001
fix 1 all neb 5.0 parallel neigh
neb 0.0 0.05 5000 0 10 final final.txt
write_data neb_$u.data nocoeff

