atom_style      atomic
units           metal
boundary        p p p
read_data        ../../structure/duplicated_NiCoTiZrHf_screw_9792.lmp

mass     1 58.6934
mass     2 58.933195
mass     3 47.867
mass     4 91.224
###############################

variable reg_zhi equal $(lz)
variable reg_zlo equal $(lz)*0.50
variable reg_xlo equal $(lx)*0.25
variable reg_xhi equal $(lx)*0.75
region regL block ${reg_xlo} ${reg_xhi} EDGE EDGE ${reg_zlo} ${reg_zhi} units box
group left region regL

change_box all z final 0 $(lz) remap units box
variable	lb equal $(ly)/12
displace_atoms	left ramp y 0.0 ${lb} x ${reg_xlo} ${reg_xhi} units box

neighbor        1.0 bin
neigh_modify    every 5 delay 0 check yes

write_data HEA_init_screw.data nocoeff


