# Demonstrate SNAP Ta potential
# Initialize simulation
atom_style atomic
units metal
read_data ../HEA_init.data

mass 1 58.6934
mass 2 58.933195
mass 3 47.867
mass 4 91.224
mass 5 178.49

pair_style snap
pair_coeff * * ../HEA.snapcoeff ../HEA.snapparam Ni Co Ti Zr Hf


# Setup output
thermo_style custom step temp pe etotal pxx pyy pzz lx ly lz density

# Set up NVE run

timestep 0.001
neighbor 1.0 bin
neigh_modify every 5 delay 0 check yes 
thermo		100
variable lenx equal lx
variable leny equal ly
variable lenz equal lz
# Run MD
thermo		100
reset_timestep 0
velocity all create 300.0 36954846
dump 1 all custom 1000 md_npt_dump.cfg id type x y z
fix 1 all npt temp 300 300 0.1 aniso 0 0 1.0
fix avg all ave/time 10 5000 500000 v_lenx v_leny v_lenz
run            500000
undump 1
unfix 1

variable newlx equal f_avg[1]
variable newly equal f_avg[2]
variable newlz equal f_avg[3]
change_box all x final 0 ${newlx} y final 0 ${newly} z final 0 ${newlz} remap units box
unfix avg
minimize	0.0 0.02 5000 10000
write_data after_relax.data nocoeff
